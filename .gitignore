logs/
*.log
npm-debug.log*

# Runtime / local uploads (if created)
uploads/
temp/
tmp/

# Local MongoDB dumps (may contain PII)
db-dump/

# Test / coverage
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db

# Editor (optional — remove these lines if your team commits shared settings)
.idea/

# Build artifacts (if you add zip/deploy scripts locally)
*.zip
deploy.zip
