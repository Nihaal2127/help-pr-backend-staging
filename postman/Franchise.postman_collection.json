{
  "info": {
    "_postman_id": "b2c3d4e5-franchise-api-collection",
    "name": "Help PR — Franchise API",
    "description": "CRUD and utilities for `/api/franchise`. Set `base_url`, `auth_token`, and id variables in the active environment. All ids are 24-char MongoDB ObjectIds.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5001" },
    { "key": "auth_token", "value": "" },
    { "key": "franchise_id", "value": "" },
    { "key": "state_id", "value": "" },
    { "key": "city_id", "value": "" },
    { "key": "area_id", "value": "" },
    { "key": "admin_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Franchise",
      "item": [
        {
          "name": "Create franchise",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"North Zone\",\n  \"state_id\": \"{{state_id}}\",\n  \"city_id\": \"{{city_id}}\",\n  \"area_id\": [\"{{area_id}}\"],\n  \"admin_id\": \"{{admin_id}}\",\n  \"contact\": \"+919999999999\",\n  \"is_active\": true,\n  \"description\": \"Main franchise\",\n  \"desc\": \"\",\n  \"desc2\": \"\"\n}"
            },
            "url": "{{base_url}}/api/franchise/create",
            "description": "Requires name, state_id, city_id, admin_id, contact, is_active. area_id is an array (can be []). City must belong to state; areas must belong to city."
          }
        },
        {
          "name": "Get all franchises (paginated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/franchise/getAll?page=1&limit=10&sort=-1"
          },
          "description": "Optional query params: name, state_id, city_id, admin_id, is_active (append to URL)."
        },
        {
          "name": "Get franchise by id",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/franchise/get/{{franchise_id}}"
          }
        },
        {
          "name": "Update franchise",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"North Zone East\",\n  \"is_active\": true,\n  \"contact\": \"+919988776655\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": "{{base_url}}/api/franchise/update/{{franchise_id}}"
          }
        },
        {
          "name": "Delete franchise (soft)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/franchise/delete/{{franchise_id}}"
          }
        },
        {
          "name": "Import franchises",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [\n    {\n      \"name\": \"South Hub\",\n      \"state_id\": \"{{state_id}}\",\n      \"city_id\": \"{{city_id}}\",\n      \"area_id\": [\"{{area_id}}\"],\n      \"admin_id\": \"{{admin_id}}\",\n      \"contact\": \"+918888888888\",\n      \"is_active\": true,\n      \"description\": \"Imported\"\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/api/franchise/imports"
          }
        },
        {
          "name": "Dropdown (no auth)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/franchise/getDropDown"
          },
          "description": "Optional: `?state_id=<id>` or `?city_id=id1,id2` (comma-separated)."
        }
      ]
    },
    {
      "name": "Export",
      "item": [
        {
          "name": "Export franchises (Excel)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "" },
            "url": "{{base_url}}/api/export/franchise",
            "description": "Returns `.xlsx` (or base64 in production). Save response as file in Postman."
          }
        }
      ]
    }
  ]
}
