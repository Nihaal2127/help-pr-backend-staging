        {
          "name": "Catalog",
          "description": "Bearer required. Run **after** Update sets location (`franchise_id`). **GET /categories** returns each category with nested `services`.",
          "item": [
            {
              "name": "Categories",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "try {",
                      "  const j = pm.response.json();",
                      "  const rec = j?.data?.[0];",
                      "  if (rec?._id) pm.collectionVariables.set('categoryId', String(rec._id));",
                      "  const svc0 = rec?.services?.[0];",
                      "  const svc1 = rec?.services?.[1];",
                      "  if (svc0?._id) pm.collectionVariables.set('serviceId', String(svc0._id));",
                      "  if (svc1?._id) pm.collectionVariables.set('serviceId2', String(svc1._id));",
                      "} catch (e) {}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{token}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/mobile/partner/categories",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "mobile",
                    "partner",
                    "categories"
                  ]
                },
                "description": "**GET /api/mobile/partner/categories**\n\n- **400** if no `franchise_id` — complete location on Update first\n- **200** `data[]`: `_id`, `name`, `desc`, `image_url`, `services[]` (`_id`, `name`, `desc`, `tax`, `image_url`, `category_id`)\n- Sets `{{categoryId}}`, `{{serviceId}}`, `{{serviceId2}}` from first category's services"
              },
              "response": []
            }
          ]
        },
