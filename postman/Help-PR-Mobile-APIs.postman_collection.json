                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
                },
                "method": "PUT",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "gender", "value": "female", "type": "text" },
                    { "key": "experience", "value": "2 years", "type": "text" },
                    { "key": "state_id", "value": "{{stateId}}", "type": "text" },
                    { "key": "city_id", "value": "{{cityId}}", "type": "text" },
                    { "key": "area_id", "value": "{{areaId}}", "type": "text" },
                    { "key": "pincode", "value": "{{pincode}}", "type": "text" },
                    { "key": "address", "value": "12 MG Road, Hyderabad", "type": "text" },
                    {
                      "key": "partner_services",
                      "value": "[{\"category_id\":\"{{categoryId}}\",\"services\":[{\"service_id\":\"{{serviceId}}\",\"description\":\"Home cleaning\",\"price\":499},{\"service_id\":\"{{serviceId2}}\",\"description\":\"Deep cleaning\",\"price\":799}]}]",
                      "type": "text",
                      "description": "Run Catalog first for IDs. Multiple services: add more in services[]"
                    },
                    { "key": "image", "type": "file", "src": [], "description": "Profile photo — max 512 KB" },
                    { "key": "name", "value": "Neha Sharma", "type": "text", "disabled": true },
                    { "key": "email", "value": "{{email}}", "type": "text", "disabled": true },
                    { "key": "phone_number", "value": "+916309654123", "type": "text", "disabled": true },
                    { "key": "date_of_birth", "value": "2003-05-23", "type": "text", "disabled": true }
                  ]
