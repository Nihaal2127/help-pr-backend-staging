                  "  }",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_token\": \"{{deviceToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/mobile/partner/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile", "partner", "login"]
            },
            "description": "**POST /api/mobile/partner/login**\n\n- No Authorization\n- **Required:** email, password\n- Allows pending partners for onboarding\n- Use `data.verification_status` (1=pending, 2=approved, 3=rejected), `data.is_active`"
          },
          "response": []
        },
        {
