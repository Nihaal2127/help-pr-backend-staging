                {
                  "key": "bank_account",
                  "value": "[{\"bank_name\":\"HDFC Bank\",\"branch_name\":\"Madhapur\",\"account_holder_name\":\"Neha Sharma\",\"account_number\":\"123456789012\",\"ifsc_code\":\"HDFC0001234\",\"is_primary\":true},{\"bank_name\":\"SBI\",\"branch_name\":\"Gachibowli\",\"account_holder_name\":\"Neha Sharma\",\"account_number\":\"987654321098\",\"ifsc_code\":\"SBIN0001234\",\"is_primary\":false}]",
                  "type": "text",
                  "description": "JSON array = replace all banks. Single object = upsert one."
                },
                {
                  "key": "partner_services",
                  "value": "[{\"category_id\":\"{{categoryId}}\",\"services\":[{\"service_id\":\"{{serviceId}}\",\"description\":\"Home cleaning\",\"price\":499}]}]",
                  "type": "text",
                  "description": "Use catalog IDs after Categories/Services, or valid 24-hex test IDs"
