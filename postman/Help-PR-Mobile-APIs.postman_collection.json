                      "} catch (e) {}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{baseUrl}}/api/mobile/partner/cities?state_id={{stateId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "mobile", "partner", "cities"],
                  "query": [{ "key": "state_id", "value": "{{stateId}}" }]
                },
                "description": "**GET /api/mobile/partner/cities** — sets `{{cityId}}`"
              },
              "response": []
