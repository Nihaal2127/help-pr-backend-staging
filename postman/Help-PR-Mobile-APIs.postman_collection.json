        {
          "name": "Location",
          "description": "Public address dropdowns. No Bearer. Run in order: States → Cities → Areas → Pincodes.",
          "item": [
            {
              "name": "States",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "try {",
                      "  const j = pm.response.json();",
                      "  pm.test('success', () => pm.expect(j.success).to.eql(true));",
                      "  const rec = j?.records?.[0];",
                      "  if (rec?._id) pm.collectionVariables.set('stateId', String(rec._id));",
                      "} catch (e) {}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{baseUrl}}/api/mobile/partner/states",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "mobile", "partner", "states"]
                },
                "description": "**GET /api/mobile/partner/states** — sets `{{stateId}}`"
              },
              "response": []
            },
            {
              "name": "Cities",
              "event": [
                {
                  "listen": "test",
                  "script": {
