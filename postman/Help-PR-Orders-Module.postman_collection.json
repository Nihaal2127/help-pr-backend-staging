{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Help PR — Orders module (orders, line items, charges, payments, Razorpay)",
    "description": "Order APIs for help-pr-backend-staging.\n\n**Documentation:** `docs/ORDER_MODULE_FRONTEND.md`, **`docs/ORDER_GETALL_API_CHANGES.md`** (latest getAll / access changes).\n\n**Setup:** Set `baseUrl` and `accessToken` (Bearer JWT). Use a **super admin / staff / franchise admin / employee** token for **GET /api/order/getAll** (partners & customers get **403** — use **getCustomerOrder** for customers).\n\nAfter **Create order**, copy `orderId` and `orderServiceId` into collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "accessToken", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "orderServiceId", "value": "" },
    { "key": "customerUserId", "value": "" },
    { "key": "additionalChargeId", "value": "" },
    { "key": "orderPaymentId", "value": "" },
    { "key": "franchiseId", "value": "", "description": "Optional; super/staff may filter any franchise. Franchise admin/employee must match their franchise or omit." },
    { "key": "search", "value": "", "description": "Free-text for GET /api/order/getAll (unique_id, users, category, service, quote, etc.)" },
    { "key": "from_date", "value": "2026-05-14", "description": "Date filter (ISO date). Alone = that calendar day. With to_date = overlap range." },
    { "key": "to_date", "value": "2026-05-20", "description": "Date filter (ISO date). Alone = that calendar day." },
    { "key": "orderStatus", "value": "1", "description": "order_status filter: 1 Pending, 2 In-progress, 3 Completed, 4 Cancelled" },
    { "key": "partnerId", "value": "", "description": "Optional ObjectId filter on getAll" },
    { "key": "employeeId", "value": "", "description": "Optional ObjectId filter on getAll" }
  ],
  "item": [
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order (single service, no Razorpay link)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"REPLACE_WITH_CUSTOMER_OBJECT_ID\",\n  \"user_unique_id\": \"CUST001\",\n  \"city_id\": \"REPLACE_WITH_CITY_OBJECT_ID\",\n  \"category_id\": \"REPLACE_WITH_CATEGORY_OBJECT_ID\",\n  \"is_paid\": false,\n  \"payment_mode_id\": \"\",\n  \"transaction_id\": \"\",\n  \"created_by_id\": \"REPLACE_WITH_SAME_OR_STAFF_USER_OBJECT_ID\",\n  \"order_status\": 1,\n  \"order_date\": \"2026-06-01\",\n  \"address\": \"123 Sample Street, City\",\n  \"sub_total\": 1000,\n  \"tax\": 0,\n  \"discount_amount\": null,\n  \"user_paltform_fee\": 0,\n  \"partner_commison_platform_fee\": 0,\n  \"total_price\": 1000,\n  \"admin_earning\": 0,\n  \"type\": 2,\n  \"partner_id\": \"REPLACE_WITH_PARTNER_USER_OBJECT_ID\",\n  \"payment_schedule_type\": \"single\",\n  \"customer_payment_method\": \"upi\",\n  \"order_description\": \"Same role as quote_description; optional free text.\",\n  \"quote_id\": null,\n  \"service_items\": [\n    {\n      \"user_id\": \"REPLACE_WITH_CUSTOMER_OBJECT_ID\",\n      \"partner_id\": \"REPLACE_WITH_PARTNER_USER_OBJECT_ID\",\n      \"category_id\": \"REPLACE_WITH_CATEGORY_OBJECT_ID\",\n      \"service_id\": \"REPLACE_WITH_SERVICE_OBJECT_ID\",\n      \"service_date\": \"2026-06-01T00:00:00.000Z\",\n      \"service_from_time\": \"2026-06-01T09:00:00.000Z\",\n      \"service_to_time\": \"2026-06-01T17:00:00.000Z\",\n      \"sub_total\": 1000,\n      \"tax\": 0,\n      \"service_price\": 1000,\n      \"user_paltform_fee\": 0,\n      \"partner_commison_platform_fee\": 0,\n      \"partner_earning\": 1000,\n      \"total_price\": 1000,\n      \"admin_earning\": 0\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/order/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "create"]
            },
            "description": "POST /api/order/create — `service_items` must be **exactly one** object. Middleware requires prices and `order_status`. Server recomputes `total_price` after save. Copy `record.order_id` and resolve `orderServiceId` from GET order by id (`service_items[0]._id`)."
          },
          "response": []
        },
        {
          "name": "Create order (Razorpay payment link — payment_mode_id 2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"REPLACE_WITH_CUSTOMER_OBJECT_ID\",\n  \"user_unique_id\": \"CUST001\",\n  \"city_id\": \"REPLACE_WITH_CITY_OBJECT_ID\",\n  \"category_id\": \"REPLACE_WITH_CATEGORY_OBJECT_ID\",\n  \"is_paid\": false,\n  \"payment_mode_id\": \"2\",\n  \"transaction_id\": \"\",\n  \"created_by_id\": \"REPLACE_WITH_STAFF_USER_OBJECT_ID\",\n  \"order_status\": 1,\n  \"order_date\": \"2026-06-01\",\n  \"address\": \"123 Sample Street\",\n  \"sub_total\": 1500,\n  \"tax\": 0,\n  \"discount_amount\": null,\n  \"user_paltform_fee\": 0,\n  \"partner_commison_platform_fee\": 0,\n  \"total_price\": 1500,\n  \"admin_earning\": 0,\n  \"type\": 2,\n  \"name\": \"Customer Name\",\n  \"email\": \"customer@example.com\",\n  \"contact\": \"9999999999\",\n  \"order_description\": \"\",\n  \"quote_id\": null,\n  \"service_items\": [\n    {\n      \"user_id\": \"REPLACE_WITH_CUSTOMER_OBJECT_ID\",\n      \"partner_id\": \"REPLACE_WITH_PARTNER_USER_OBJECT_ID\",\n      \"category_id\": \"REPLACE_WITH_CATEGORY_OBJECT_ID\",\n      \"service_id\": \"REPLACE_WITH_SERVICE_OBJECT_ID\",\n      \"service_date\": \"2026-06-01T00:00:00.000Z\",\n      \"service_from_time\": \"2026-06-01T09:00:00.000Z\",\n      \"service_to_time\": \"2026-06-01T17:00:00.000Z\",\n      \"sub_total\": 1500,\n      \"tax\": 0,\n      \"service_price\": 1500,\n      \"user_paltform_fee\": 0,\n      \"partner_commison_platform_fee\": 0,\n      \"partner_earning\": 1500,\n      \"total_price\": 1500,\n      \"admin_earning\": 0\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/order/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "create"]
            },
            "description": "When `payment_mode_id` is `\"2\"`, backend creates a Razorpay payment link. Response includes `payment_url` and `order_id`. Requires valid Razorpay env on server."
          },
          "response": []
        },
        {
          "name": "Get order by id (full detail)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/order/get/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "get", "{{orderId}}"]
            },
            "description": "GET /api/order/get/:id — includes `additional_charges`, `order_payments`, populated refs.\n\n**Access (same as quotes):** Super admin / staff — any order. Franchise admin / employee — only orders in their franchise (**403** otherwise). Partner / customer — **403** (use participant flows or getCustomerOrder for customers)."
          },
          "response": []
        },
        {
          "name": "Get all orders (paginated — full filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/order/getAll?page=1&limit=10&order_status={{orderStatus}}&is_paid=&search={{search}}&from_date={{from_date}}&to_date={{to_date}}&franchise_id={{franchiseId}}&user_id={{customerUserId}}&partner_id={{partnerId}}&employee_id={{employeeId}}&category_id=&service_id=&city_id=&sort_by=created_at&sort_order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "getAll"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "order_status", "value": "{{orderStatus}}", "description": "1 Pending | 2 In-progress | 3 Completed | 4 Cancelled. Invalid → 409." },
                { "key": "is_paid", "value": "", "disabled": true, "description": "true | false" },
                { "key": "search", "value": "{{search}}", "description": "Sanitized free-text (same idea as quote getAll)" },
                { "key": "keyword", "value": "", "disabled": true, "description": "Legacy alias for search when search is empty" },
                { "key": "from_date", "value": "{{from_date}}", "description": "Schedule/order_date filter. Alone = that UTC day. With to_date = overlap range." },
                { "key": "to_date", "value": "{{to_date}}", "description": "Schedule/order_date filter. Alone = that UTC day." },
                { "key": "franchise_id", "value": "{{franchiseId}}", "description": "Scoped by JWT role (see docs/ORDER_GETALL_API_CHANGES.md)" },
                { "key": "user_id", "value": "{{customerUserId}}", "disabled": true },
                { "key": "partner_id", "value": "{{partnerId}}", "disabled": true },
                { "key": "employee_id", "value": "{{employeeId}}", "disabled": true },
                { "key": "category_id", "value": "", "disabled": true },
                { "key": "service_id", "value": "", "disabled": true },
                { "key": "city_id", "value": "", "disabled": true },
                { "key": "sort_by", "value": "created_at", "description": "created_at|updated_at|order_date|order_status|total_price|sub_total|unique_id|is_paid|tax|min_deposit|order_description" },
                { "key": "sort_order", "value": "desc", "description": "asc | desc (case-insensitive collation)" },
                { "key": "sort", "value": "-1", "disabled": true, "description": "Legacy: 1 asc, else desc when sort_order omitted" }
              ]
            },
            "description": "GET /api/order/getAll — aligned with **GET /api/quote/getAll**.\n\n**Who can call:** Super admin (5), Staff (6), Franchise admin (1), Employee (3). Partner / Customer → **403**.\n\n**franchise_id:** Super/staff optional filter; franchise admin/employee auto-scoped to their franchise.\n\n**Date filters:** `from_date` and/or `to_date` (ISO). One param alone filters that calendar day; both = schedule overlap + `order_date` fallback.\n\n**Response:** Hydrated list rows (`user_id`, `partner_id`, `category_id`, `service_id`, `franchise_id`, `quote_id`, display names)."
          },
          "response": []
        },
        {
          "name": "Get all orders — from_date only (single day)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/order/getAll?page=1&limit=10&from_date={{from_date}}&sort_by=order_date&sort_order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "getAll"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "from_date", "value": "{{from_date}}", "description": "Only this param → orders active on that UTC day" },
                { "key": "sort_by", "value": "order_date" },
                { "key": "sort_order", "value": "desc" }
              ]
            },
            "description": "Example: filter by **from_date only** (no to_date). Matches orders whose schedule or `order_date` falls on that day."
          },
          "response": []
        },
        {
          "name": "Get all orders — to_date only (single day)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/order/getAll?page=1&limit=10&to_date={{to_date}}&sort_by=order_date&sort_order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "getAll"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "to_date", "value": "{{to_date}}", "description": "Only this param → orders active on that UTC day" },
                { "key": "sort_by", "value": "order_date" },
                { "key": "sort_order", "value": "desc" }
              ]
            },
            "description": "Example: filter by **to_date only** (no from_date). Same single-day semantics as from_date-only."
          },
          "response": []
        },
        {
          "name": "Get all orders — search + franchise",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/order/getAll?page=1&limit=10&search={{search}}&franchise_id={{franchiseId}}&sort_by=created_at&sort_order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "getAll"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "{{search}}" },
                { "key": "franchise_id", "value": "{{franchiseId}}" },
                { "key": "sort_by", "value": "created_at" },
                { "key": "sort_order", "value": "desc" }
              ]
            },
            "description": "Text search across order fields and joined user/category/service/franchise/quote data."
          },
          "response": []
        },
        {
          "name": "Get customer orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/order/getCustomerOrder?user_id={{customerUserId}}&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "getCustomerOrder"],
              "query": [
                { "key": "user_id", "value": "{{customerUserId}}" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Requires `user_id` query param (Mongo ObjectId string)."
          },
          "response": []
        },
        {
          "name": "Update order (status / paid)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_status\": 2,\n  \"is_paid\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/order/update/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "update", "{{orderId}}"]
            },
            "description": "`order_status` only moves forward vs current. `is_paid` propagates to non-cancelled line items."
          },
          "response": []
        },
        {
          "name": "Update order service line",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_id\": \"REPLACE_WITH_PARTNER_OBJECT_ID\",\n  \"service_status\": 2,\n  \"service_date\": \"2026-06-02\",\n  \"service_from_time\": \"2026-06-02T10:00:00.000Z\",\n  \"service_to_time\": \"2026-06-02T18:00:00.000Z\",\n  \"is_paid\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/order/serviceUpdate/{{orderServiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "serviceUpdate", "{{orderServiceId}}"]
            },
            "description": "URL param is **order_service** `_id`, not order id. Middleware validates partner/service_status/date fields when present."
          },
          "response": []
        },
        {
          "name": "Cancel service on order",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
