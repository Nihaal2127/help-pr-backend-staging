              "raw": "{\n  \"order_id\": \"{{orderId}}\",\n  \"payer_type\": \"customer\",\n  \"amount\": 500,\n  \"payment_method\": \"upi\",\n  \"status\": \"completed\",\n  \"transaction_reference\": \"UPIREF123\",\n  \"installment_index\": null,\n  \"notes\": \"Partial payment\"\n}",
              "options": { "raw": { "language": "json" } }
