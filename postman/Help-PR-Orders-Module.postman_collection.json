              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "getCustomerOrder"],
              "query": [
                { "key": "user_id", "value": "{{customerUserId}}" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
