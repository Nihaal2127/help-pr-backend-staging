            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_id\": \"REPLACE_WITH_PARTNER_OBJECT_ID\",\n  \"service_status\": \"completed\",\n  \"service_date\": \"2026-06-02\",\n  \"service_from_time\": \"2026-06-02T10:00:00.000Z\",\n  \"service_to_time\": \"2026-06-02T18:00:00.000Z\",\n  \"is_paid\": false\n}",
