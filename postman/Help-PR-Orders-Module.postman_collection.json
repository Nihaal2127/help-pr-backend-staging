            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_items_id\": \"{{orderServiceId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/order/cancleService/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "cancleService", "{{orderId}}"]
            },
            "description": "Path = order id. Body `service_items_id` = order_service id."
          },
          "response": []
        },
        {
