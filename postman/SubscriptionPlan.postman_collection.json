{
  "info": {
    "_postman_id": "c3d4e5f6-subscription-plan-api-collection",
    "name": "Help PR — Subscription Plan API",
    "description": "CRUD and utilities for `/api/subscription-plan`. Set `base_url`, `auth_token`, and `subscription_plan_id` in the active environment. Ids are 24-char MongoDB ObjectIds. `plan_name` must be one of: basic, silver, gold, platinum (one active plan per tier).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5001" },
    { "key": "auth_token", "value": "" },
    { "key": "subscription_plan_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Subscription plan",
      "item": [
        {
          "name": "Create subscription plan",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_name\": \"basic\",\n  \"plan_description\": \"Basic tier with essential features.\",\n  \"price\": 499,\n  \"duration\": 30,\n  \"duration_type\": \"days\",\n  \"priority\": 1,\n  \"is_active\": true\n}"
            },
            "url": "{{base_url}}/api/subscription-plan/create",
            "description": "Requires plan_name (tier slug), plan_description, price, duration, duration_type (days|months), is_active. Optional priority."
          }
        },
        {
          "name": "Get all subscription plans (paginated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/subscription-plan/getAll?page=1&limit=10&sort=-1"
          },
          "description": "Optional query: is_active, plan_name (basic|silver|gold|platinum), duration_type (days|months)."
        },
        {
          "name": "Get subscription plan by id",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/subscription-plan/get/{{subscription_plan_id}}"
          }
        },
        {
          "name": "Update subscription plan",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_description\": \"Updated description for this tier.\",\n  \"price\": 599,\n  \"duration\": 30,\n  \"duration_type\": \"days\",\n  \"priority\": 2,\n  \"is_active\": true\n}"
            },
            "url": "{{base_url}}/api/subscription-plan/update/{{subscription_plan_id}}"
          }
        },
        {
          "name": "Delete subscription plan (soft)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/subscription-plan/delete/{{subscription_plan_id}}"
          }
        },
        {
          "name": "Import subscription plans",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [\n    {\n      \"plan_name\": \"silver\",\n      \"plan_description\": \"Silver tier\",\n      \"price\": 999,\n      \"duration\": 3,\n      \"duration_type\": \"months\",\n      \"priority\": 2,\n      \"is_active\": true\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/api/subscription-plan/imports"
          },
          "description": "Each row needs unique plan_name among non-deleted plans. Adjust tiers if you already created some via Create."
        },
        {
          "name": "Dropdown (no auth)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/subscription-plan/getDropDown"
          },
          "description": "Optional: `?duration_type=days` or `months`. Returns active, non-deleted plans."
        }
      ]
    }
  ]
}
