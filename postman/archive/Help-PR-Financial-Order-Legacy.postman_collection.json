{
  "info": {
    "name": "Help PR — Financial order (ARCHIVED)",
    "description": "**Archived May 2026** — `/api/financial-order` is no longer mounted.\n\nUse **`GET /api/order/financial-payments/getAll`** and **`GET /api/order/financial-payments/get/:id`** instead.\n\nSee `docs/FINANCIAL_ORDER_PAYMENTS_API.md` and `archive/financial-order/README.md`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "REMOVED — was GET /api/financial-order/getAll",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/order/financial-payments/getAll?page=1&limit=20"
      },
      "description": "Replacement endpoint (active)."
    },
    {
      "name": "REMOVED — was GET /api/financial-order/get/:id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/order/financial-payments/get/{{orderId}}"
      },
      "description": "Replacement endpoint (active). :id = order Mongo _id."
    }
  ]
}
