{
  "info": {
    "_postman_id": "e7d3c1b0-9a8f-4e7d-bc1a-2f3e4d5c6b7a",
    "name": "Content + Expense Category + Expense Management",
    "description": "Postman collection for **`/api/content-management`**, **`/api/expense-category-management`**, and **`/api/expense-management`** (see `server.js`).\n\n**Setup:** Set **`{{baseUrl}}`** (e.g. `http://localhost:5001` or your API Gateway stage URL). Run **Login** to set **`{{token}}`**. Set **`{{franchiseId}}`** to a real franchise ObjectId before expense category / expense calls.\n\n**Dashboard counts:** **`POST /api/getCount`** with body `type` = **`content-management`**, **`expenses`**, or **`settings-expense-categories`** (see `count_controller.js` → `resolveCountType`).\n\n**Variables:** Expense category **Create** saves **`{{expenseCategoryId}}`** (parent category document) and **`{{expenseSubcategoryId}}`** for **`POST /api/expense-management/create`** — these names avoid clashing with catalogue **`categoryId`** used elsewhere.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 — Auth & health",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  if (j && j.record && j.record.auth_token) {",
                  "    pm.collectionVariables.set('token', j.record.auth_token);",
                  "  }",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_token\": \"{{deviceToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Saves JWT to collection variable **`token`**."
          }
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "No auth."
          }
        }
      ]
    },
    {
      "name": "01 — Dashboard (getCount)",
      "item": [
        {
          "name": "getCount — content-management",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"content-management\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/getCount",
              "host": ["{{baseUrl}}"],
              "path": ["api", "getCount"]
            },
            "description": "Returns **`total_content`** under **`record`**."
          }
        },
        {
          "name": "getCount — expenses",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"expenses\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/getCount",
              "host": ["{{baseUrl}}"],
              "path": ["api", "getCount"]
            },
            "description": "Franchise admin (`type` 1): scoped to caller franchise. Response includes **`total_expense`**."
          }
        },
        {
          "name": "getCount — settings-expense-categories",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"settings-expense-categories\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/getCount",
              "host": ["{{baseUrl}}"],
              "path": ["api", "getCount"]
            },
            "description": "Returns **`total_expense_category`** under **`record`** (franchise-scoped for franchise admin)."
          }
        }
      ]
    },
    {
      "name": "02 — Content management",
      "item": [
        {
          "name": "Create content",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  try {",
                  "    const j = pm.response.json();",
                  "    if (j && j.record && j.record._id) {",
                  "      pm.collectionVariables.set('contentId', String(j.record._id));",
                  "    }",
                  "  } catch (e) {}",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Terms & Conditions\",\n  \"description\": \"Application terms and conditions text.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/content-management/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content-management", "create"]
            }
          }
        },
        {
          "name": "Get all content",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content-management/getAll?page={{page}}&limit={{limit}}&search={{search}}&sort_by={{sortBy}}&sort_order={{sortOrder}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content-management", "getAll"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "limit", "value": "{{limit}}" },
                { "key": "search", "value": "{{search}}" },
                { "key": "sort_by", "value": "{{sortBy}}", "description": "Optional; server also accepts `sort` as alias." },
                { "key": "sort_order", "value": "{{sortOrder}}", "description": "Use `asc` or default desc." }
              ]
            }
          }
        },
        {
          "name": "Get content by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content-management/get/{{contentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content-management", "get", "{{contentId}}"]
            }
          }
        },
        {
          "name": "Update content",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Payment Policy\",\n  \"description\": \"Payment-related policies.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/content-management/update/{{contentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content-management", "update", "{{contentId}}"]
            }
          }
        },
        {
          "name": "Delete content",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content-management/delete/{{contentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content-management", "delete", "{{contentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03 — Expense category management",
      "item": [
        {
          "name": "Create expense category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  try {",
                  "    const j = pm.response.json();",
                  "    if (j && j.record) {",
                  "      if (j.record._id) pm.collectionVariables.set('expenseCategoryId', String(j.record._id));",
                  "      if (j.record.subcategory_id) pm.collectionVariables.set('expenseSubcategoryId', String(j.record.subcategory_id));",
                  "    }",
                  "  } catch (e) {}",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"franchise_id\": \"{{franchiseId}}\",\n  \"category_name\": \"Travel\",\n  \"sub_category_name\": \"Fuel\",\n  \"description\": \"Travel and commute related expenses.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/expense-category-management/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-category-management", "create"]
            },
            "description": "Saves **`expenseCategoryId`** (parent) and **`expenseSubcategoryId`** for expense create — does not overwrite catalogue **`categoryId`**."
          }
        },
        {
          "name": "Get all expense categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-category-management/getAll?page={{page}}&limit={{limit}}&search={{search}}&sort_by={{sortBy}}&sort_order={{sortOrder}}&franchise_id={{franchiseId}}&startDate={{startDate}}&endDate={{endDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-category-management", "getAll"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "limit", "value": "{{limit}}" },
                { "key": "search", "value": "{{search}}" },
                { "key": "sort_by", "value": "{{sortBy}}" },
                { "key": "sort", "value": "{{sort}}", "description": "Alias of sort_by when sort_by empty." },
                { "key": "sort_order", "value": "{{sortOrder}}" },
                { "key": "franchise_id", "value": "{{franchiseId}}" },
                { "key": "startDate", "value": "{{startDate}}" },
                { "key": "endDate", "value": "{{endDate}}" }
              ]
            }
          }
        },
        {
          "name": "Get expense category by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-category-management/get/{{expenseCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-category-management", "get", "{{expenseCategoryId}}"]
            }
          }
        },
        {
          "name": "Update expense category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"franchise_id\": \"{{franchiseId}}\",\n  \"category_name\": \"Travel (updated)\",\n  \"sub_category_name\": \"Fuel (updated)\",\n  \"description\": \"Updated description.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/expense-category-management/update/{{expenseCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-category-management", "update", "{{expenseCategoryId}}"]
            }
          }
        },
        {
          "name": "Delete expense category",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-category-management/delete/{{expenseCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-category-management", "delete", "{{expenseCategoryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "04 — Expense management",
      "item": [
        {
          "name": "Create expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  try {",
                  "    const j = pm.response.json();",
                  "    if (j && j.record && j.record._id) {",
                  "      pm.collectionVariables.set('expenseId', String(j.record._id));",
                  "    }",
                  "  } catch (e) {}",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"franchise_id\": \"{{franchiseId}}\",\n  \"category_id\": \"{{expenseCategoryId}}\",\n  \"subcategory_id\": \"{{expenseSubcategoryId}}\",\n  \"expense_name\": \"Petrol\",\n  \"description\": \"Client visit travel.\",\n  \"expense_amount\": 500,\n  \"expense_date\": \"2026-05-12\",\n  \"payment_mode\": \"UPI\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/expense-management/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-management", "create"]
            },
            "description": "**`category_id`** = expense category document id (`expenseCategoryId`). **`subcategory_id`** = expense subcategory id (`expenseSubcategoryId`)."
          }
        },
        {
          "name": "Get all expenses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-management/getAll?page={{page}}&limit={{limit}}&search={{search}}&sort_by={{sortBy}}&sort_order={{sortOrder}}&franchise_id={{franchiseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-management", "getAll"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "limit", "value": "{{limit}}" },
                { "key": "search", "value": "{{search}}" },
                { "key": "sort_by", "value": "{{sortBy}}" },
                { "key": "sort", "value": "{{sort}}" },
                { "key": "sort_order", "value": "{{sortOrder}}" },
                { "key": "franchise_id", "value": "{{franchiseId}}" }
              ]
            },
            "description": "Optional **`sort_by`**: `id`, `category`, `subcategory`, `expense_name`, `amount`, `date`, `payment_mode`, or default `created_at`."
          }
        },
        {
          "name": "Get expense by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-management/get/{{expenseId}}?franchise_id={{franchiseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-management", "get", "{{expenseId}}"],
              "query": [
                { "key": "franchise_id", "value": "{{franchiseId}}", "description": "Required for franchise-scoped lookup." }
              ]
            }
          }
        },
        {
          "name": "Update expense",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"franchise_id\": \"{{franchiseId}}\",\n  \"category_id\": \"{{expenseCategoryId}}\",\n  \"subcategory_id\": \"{{expenseSubcategoryId}}\",\n  \"expense_name\": \"Petrol (updated)\",\n  \"description\": \"Updated notes.\",\n  \"expense_amount\": 650,\n  \"expense_date\": \"2026-05-12\",\n  \"payment_mode\": \"Online\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/expense-management/update/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-management", "update", "{{expenseId}}"]
            }
          }
        },
        {
          "name": "Delete expense",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-management/delete/{{expenseId}}?franchise_id={{franchiseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-management", "delete", "{{expenseId}}"],
              "query": [
                { "key": "franchise_id", "value": "{{franchiseId}}" }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
