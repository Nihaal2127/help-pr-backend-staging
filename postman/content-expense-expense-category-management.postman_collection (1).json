    { "key": "token", "value": "" },
    { "key": "franchiseId", "value": "PUT_FRANCHISE_OBJECT_ID_24_HEX" },
    { "key": "page", "value": "1" },
    { "key": "limit", "value": "10" },
    { "key": "search", "value": "" },
    { "key": "sort", "value": "" },
    { "key": "sortBy", "value": "created_at" },
    { "key": "sortOrder", "value": "desc" },
    { "key": "startDate", "value": "" },
    { "key": "endDate", "value": "" },
    { "key": "contentId", "value": "" },
    { "key": "expenseCategoryId", "value": "" },
    { "key": "expenseSubcategoryId", "value": "" },
    { "key": "expenseId", "value": "" }
  ]
}
