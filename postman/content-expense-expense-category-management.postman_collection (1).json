            "url": {
              "raw": "{{baseUrl}}/api/expense-management/getAll?page={{page}}&limit={{limit}}&search={{search}}&sort_by={{sortBy}}&sort_order={{sortOrder}}&franchise_id={{franchiseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-management", "getAll"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "limit", "value": "{{limit}}" },
                { "key": "search", "value": "{{search}}" },
                { "key": "sort_by", "value": "{{sortBy}}" },
                { "key": "sort", "value": "{{sort}}" },
                { "key": "sort_order", "value": "{{sortOrder}}" },
                { "key": "franchise_id", "value": "{{franchiseId}}" }
              ]
            },
            "description": "Optional **`sort_by`**: `id`, `category`, `subcategory`, `expense_name`, `amount`, `date`, `payment_mode`, or default `created_at`."
          }
        },
        {
          "name": "Get expense by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-management/get/{{expenseId}}?franchise_id={{franchiseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-management", "get", "{{expenseId}}"],
              "query": [
                { "key": "franchise_id", "value": "{{franchiseId}}", "description": "Required for franchise-scoped lookup." }
              ]
            }
          }
        },
        {
          "name": "Update expense",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"franchise_id\": \"{{franchiseId}}\",\n  \"category_id\": \"{{expenseCategoryId}}\",\n  \"subcategory_id\": \"{{expenseSubcategoryId}}\",\n  \"expense_name\": \"Petrol (updated)\",\n  \"description\": \"Updated notes.\",\n  \"expense_amount\": 650,\n  \"expense_date\": \"2026-05-12\",\n  \"payment_mode\": \"Online\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/expense-management/update/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-management", "update", "{{expenseId}}"]
            }
          }
        },
        {
          "name": "Delete expense",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-management/delete/{{expenseId}}?franchise_id={{franchiseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-management", "delete", "{{expenseId}}"],
              "query": [
                { "key": "franchise_id", "value": "{{franchiseId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "05 — State, City & Area",
      "description": "Routes from `state_routes.js`, `city_routes.js`, `area_routes.js`. All routes use rate limiting. **`getDropDown`** for each resource has **no** `authMiddleware` in code; other calls need **`Bearer {{token}}`**.",
      "item": [
        {
          "name": "State",
          "item": [
            {
              "name": "Create state",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  try {",
                      "    const j = pm.response.json();",
                      "    if (j && j.savedState && j.savedState._id) {",
                      "      pm.collectionVariables.set('stateId', String(j.savedState._id));",
                      "    }",
                      "    if (j && j.savedState && j.savedState.name) {",
                      "      pm.collectionVariables.set('stateNameForImport', String(j.savedState.name));",
                      "    }",
                      "  } catch (e) {}",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"State-{{$timestamp}}\",\n  \"is_active\": true\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/state/create",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "state", "create"]
                },
                "description": "Response includes **`savedState`**. Resend the same **`name`** to verify **409** `State name already exists.`"
              }
            },
            {
              "name": "Get all states",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/state/getAll?page={{page}}&limit={{limit}}&name=&is_active=&sort_by=name&sort_order=1",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "state", "getAll"],
                  "query": [
                    { "key": "page", "value": "{{page}}" },
                    { "key": "limit", "value": "{{limit}}" },
                    { "key": "name", "value": "", "description": "Optional search (regex, case-insensitive)." },
                    { "key": "keyword", "value": "", "disabled": true, "description": "Alias for name search." },
                    { "key": "is_active", "value": "", "description": "Optional boolean filter." },
                    { "key": "sort_by", "value": "name", "description": "`name` or default `created_at`." },
                    { "key": "sort_order", "value": "1", "description": "`1` asc, `-1` desc." }
                  ]
                }
              }
            },
            {
              "name": "Get state by id",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/state/get/{{stateId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "state", "get", "{{stateId}}"]
                }
              }
            },
            {
              "name": "Update state",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"State-Updated-{{$timestamp}}\",\n  \"is_active\": true\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/state/update/{{stateId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "state", "update", "{{stateId}}"]
                }
              }
            },
            {
              "name": "Import states",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"records\": [\n    { \"name\": \"Import-State-A-{{$timestamp}}\", \"is_active\": true },\n    { \"name\": \"Import-State-B-{{$timestamp}}\", \"is_active\": false }\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/state/imports",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "state", "imports"]
                }
              }
            },
            {
              "name": "Get state dropdown",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/state/getDropDown",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "state", "getDropDown"]
                },
                "description": "No auth in `state_routes`."
              }
            },
            {
              "name": "Delete state (soft)",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/state/delete/{{stateId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "state", "delete", "{{stateId}}"]
                }
              }
            }
          ]
        },
        {
          "name": "City",
          "item": [
            {
              "name": "Create city",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  try {",
                      "    const j = pm.response.json();",
                      "    if (j && j.record && j.record._id) {",
                      "      pm.collectionVariables.set('cityId', String(j.record._id));",
                      "    }",
                      "  } catch (e) {}",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
