    {
      "name": "03 — Expense category management",
      "item": [
        {
          "name": "Create expense category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  try {",
                  "    const j = pm.response.json();",
                  "    if (j && j.record) {",
                  "      if (j.record._id) pm.collectionVariables.set('expenseCategoryId', String(j.record._id));",
                  "      if (j.record.subcategory_id) pm.collectionVariables.set('expenseSubcategoryId', String(j.record.subcategory_id));",
                  "    }",
                  "  } catch (e) {}",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"franchise_id\": \"{{franchiseId}}\",\n  \"category_name\": \"Travel\",\n  \"sub_category_name\": \"Fuel\",\n  \"description\": \"Travel and commute related expenses.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/expense-category-management/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-category-management", "create"]
            },
            "description": "Saves **`expenseCategoryId`** (parent) and **`expenseSubcategoryId`** for expense create — does not overwrite catalogue **`categoryId`**."
          }
        },
        {
          "name": "Get all expense categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-category-management/getAll?page={{page}}&limit={{limit}}&search={{search}}&sort_by={{sortBy}}&sort_order={{sortOrder}}&franchise_id={{franchiseId}}&startDate={{startDate}}&endDate={{endDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-category-management", "getAll"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "limit", "value": "{{limit}}" },
                { "key": "search", "value": "{{search}}" },
                { "key": "sort_by", "value": "{{sortBy}}" },
                { "key": "sort", "value": "{{sort}}", "description": "Alias of sort_by when sort_by empty." },
                { "key": "sort_order", "value": "{{sortOrder}}" },
                { "key": "franchise_id", "value": "{{franchiseId}}" },
                { "key": "startDate", "value": "{{startDate}}" },
                { "key": "endDate", "value": "{{endDate}}" }
              ]
            }
          }
        },
        {
          "name": "Get expense category by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-category-management/get/{{expenseCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-category-management", "get", "{{expenseCategoryId}}"]
            }
          }
        },
        {
          "name": "Update expense category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"franchise_id\": \"{{franchiseId}}\",\n  \"category_name\": \"Travel (updated)\",\n  \"sub_category_name\": \"Fuel (updated)\",\n  \"description\": \"Updated description.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/expense-category-management/update/{{expenseCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-category-management", "update", "{{expenseCategoryId}}"]
            }
          }
        },
        {
          "name": "Delete expense category",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expense-category-management/delete/{{expenseCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expense-category-management", "delete", "{{expenseCategoryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "04 — Expense management",
      "item": [
        {
          "name": "Create expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  try {",
                  "    const j = pm.response.json();",
                  "    if (j && j.record && j.record._id) {",
                  "      pm.collectionVariables.set('expenseId', String(j.record._id));",
